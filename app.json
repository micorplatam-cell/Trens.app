{
  "expo": {
    "name": "TRENS",
    "slug": "trens",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trens.app",
      "associatedDomains": ["applinks:share.trens.app", "applinks:trens.app"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.trens.app",
      "permissions": ["CAMERA", "RECORD_AUDIO"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "share.trens.app",
              "pathPrefix": "/v"
            },
            {
              "scheme": "https",
              "host": "trens.app",
              "pathPrefix": "/share"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {},
    "plugins": ["expo-router", "expo-web-browser", "expo-asset"],
    "scheme": "trensdev",
    "sdkVersion": "54.0.0",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "27fc2ccb-6af3-47ae-902f-94561e739752"
      },
      "supabaseUrl": "https://cnrcrhlrteeqsyhlxhbb.supabase.co",
