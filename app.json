{
  "expo": {
    "name": "TRENS",
    "slug": "trens",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.trens.app"
    },
    "web": {},
    "plugins": [
      "expo-router"
    ],
    "scheme": "trens",
    "sdkVersion": "54.0.0",
    "experiments": {
      "typedRoutes": true
    }
  }
}
